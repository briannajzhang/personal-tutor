{
  "name": "personal-tutor",
  "version": "0.1.0",
  "description": "Adaptive tutoring skill and Tutor Kit workspace tooling for Codex.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "personal-tutor": "./bin/personal-tutor.js"
  },
  "files": [
    "bin",
    "skills/personal-tutor",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "codex",
    "skill",
    "tutor",
    "education",
    "learning"
  ],
  "workspaces": [
    "packages/*",
    "examples/learner-workspace"
  ],
  "scripts": {
    "build": "rm -rf packages/tutor-kit/dist && tsc -b packages/tutor-kit --force && chmod +x packages/tutor-kit/dist/cli/index.js",
    "build:skill": "npm run build && node scripts/build-skill.mjs",
    "prepack": "npm run build:skill",
    "test": "npm run build && node --import tsx --test tests/*.test.ts tests/server/*.test.ts",
    "tutor": "tsx packages/tutor-kit/src/cli/index.ts",
    "compile:example": "npm run tutor -- --cwd examples/learner-workspace compile",
    "dev:example": "npm run tutor -- --cwd examples/learner-workspace dev"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
