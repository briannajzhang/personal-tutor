{
  "name": "tutor-kit",
  "version": "0.1.0",
  "description": "TypeScript SDK, CLI, and local UI server for Tutor Kit textbooks.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tutor": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -b --force && chmod +x dist/cli/index.js"
  },
  "dependencies": {
    "katex": "^0.16.47",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.5"
  }
}
