{
  "name": "tutor-kit",
  "version": "0.1.0",
  "description": "TypeScript SDK, CLI, and local UI server for Tutor Kit textbooks.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tutor": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b --force && chmod +x dist/cli/index.js"
  },
  "dependencies": {
    "katex": "^0.16.47",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.52.2",
    "shiki": "^4.3.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^8.1.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.5"
  }
}
