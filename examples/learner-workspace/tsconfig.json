{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": [
    "tutor.config.ts",
    "textbooks/**/*.ts",
    "textbooks/**/*.tsx",
    "tutor/**/*.ts",
    "tutor/**/*.tsx"
  ]
}
